# Admin password — only required when access code is "admin"
# Copy to .env.local and change in production
VITE_ADMIN_PASSWORD=montagfrei2026

# Supabase (optional) — ohne diese Werte: dynamische Kunden in localStorage
# Dashboard → Project Settings → API → Publishable key (sb_publishable_…)
# Secret key (sb_secret_…) NIEMALS ins Frontend — nur serverseitig
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
